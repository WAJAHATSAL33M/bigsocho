# Exact public origin, no trailing path. Use HTTP localhost only for local development.
NEXT_PUBLIC_SITE_URL=https://brandifya.com

# Hostinger MySQL (full prefixed database and user names from hPanel).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Required for remote production databases; optional for loopback Hostinger MySQL.
DB_SSL=false
# Optional private CA for remote MySQL (escaped newlines accepted).
DB_SSL_CA=

# Owner-only admin. Generate the hash with npm run admin:hash.
ADMIN_EMAIL=
# In hPanel paste the raw hash. In .env.local escape every $ as \$.
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Run npm run security:env in the production environment; it prints no values.
